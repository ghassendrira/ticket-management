# Configuration d'environnement - Copier vers .env

# ============ Database ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_system
DB_USER=admin
DB_PASSWORD=password

# ============ Services Ports ============
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
TICKET_SERVICE_PORT=8082
AI_SERVICE_PORT=8083
CONVERSATION_SERVICE_PORT=8084
KNOWLEDGE_BASE_SERVICE_PORT=8085
ASSIGNMENT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087

# ============ JWT & Security ============
JWT_SECRET=your-super-secret-key-change-in-production-12345
JWT_EXPIRATION=86400

# ============ AI & LLM ============
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
EMBEDDING_MODEL=all-minilm
VECTOR_DIMENSION=768

# ============ Frontend ============
FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200

# ============ Email (pour notifications) ============
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@ticket-system.com

# ============ Redis (optionnel) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ Logging ============
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs

# ============ Application ============
ENV=development
TIMEZONE=Europe/Paris
